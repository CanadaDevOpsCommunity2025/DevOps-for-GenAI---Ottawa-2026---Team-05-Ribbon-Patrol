# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: Required for AI guidance, voice and image features.
# Obtain your key from Google AI Studio: https://aistudio.google.com/
# Each developer should use their own key — the free tier is rate limited per
# key, and a shared key exhausts quota for everyone at once.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: Base URL where GitPet is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

# PORT: Server listening port (defaults to 3000)
PORT="3000"

# ---------------------------------------------------------------------------
# Live Workspace  (see docs/LIVE_WORKSPACE.md)
# ---------------------------------------------------------------------------
# Without these two, Live Workspace inspects whatever directory the server was
# started from — usually the GitPet checkout itself — and every approved action
# is refused. That combination is why actions can appear to do nothing.

# GITPET_WORKSPACE_ROOT: absolute path to the repository GitPet reads and acts
# on. Defaults to the server's working directory.
GITPET_WORKSPACE_ROOT="/absolute/path/to/your/repo"

# GITPET_ALLOW_WRITES: approved actions are refused unless this is exactly
# "true". The live scanner is read-only by default; this is the opt-in that
# lets GitPet modify a real working tree.
#
# Even when enabled, every command is re-checked against the safety policy at
# execution time, runs as argv (never a shell), and requires explicit approval.
# Destructive operations stay blocked regardless of this setting.
GITPET_ALLOW_WRITES="false"

# ---------------------------------------------------------------------------
# Access control (optional)
# ---------------------------------------------------------------------------
# HTTP Basic auth, inactive unless both are set. Enable before exposing the
# server on a shared network or tunnel: the scanner reads local repositories,
# so an open instance discloses branch names, file paths and diffs.
# GITPET_AUTH_USER="gitpet"
# GITPET_AUTH_PASS="a-long-random-value"
