# ---------------------------------------------------------------------------
# GitPet configuration
# ---------------------------------------------------------------------------

# Required for AI guidance.
GEMINI_API_KEY="your-key-here"

# Optional. Defaults to 3000. Set this to run more than one instance.
PORT=3000

# ---------------------------------------------------------------------------
# Live workspace
# ---------------------------------------------------------------------------

# The repository GitPet inspects. Defaults to the server's working directory,
# which ties the scanned repo to wherever the app is installed. Set this to
# point GitPet at the repository you actually work in.
GITPET_WORKSPACE_ROOT="/absolute/path/to/your/repo"

# Write actions are OFF by default; the live scanner is read-only. Set to
# "true" to let approved actions run against GITPET_WORKSPACE_ROOT.
#
# Every command is still checked against the safety policy at execution time,
# and a "block" verdict is refused regardless of this setting. Commands run as
# argv (never through a shell) and nothing runs without explicit approval.
GITPET_ALLOW_WRITES=false

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------

# Optional HTTP Basic auth, inactive unless both are set. Enable before
# exposing the server on a shared network or tunnel: the scanner reads local
# repositories, so an open instance discloses branch names, paths and diffs.
# GITPET_AUTH_USER="gitpet"
# GITPET_AUTH_PASS="a-long-random-value"
