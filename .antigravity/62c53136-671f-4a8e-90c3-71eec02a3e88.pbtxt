      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport {\n  Sparkles,\n  Heart,\n  AlertTriangle,\n  ShieldAlert,\n  CheckCircle2,\n  Info,\n  Mic,\n  Palette,\n  Camera,\n  Layers,\n  Wand2,\n} from \'lucide-react\';\nimport { RepositoryState, SymptomType, HealthLevel } from \'../types\';\n\ninterface PetStageProps {\n  state: RepositoryState;\n  onPetClick?: () => void;\n  customAvatarUrl?: string | null;\n  onOpenImageStudio?: () => void;\n  onOpenVoiceModal?: () => void;\n}\n\nexport const PetStage: React.FC<PetStageProps> = ({\n  state,\n  onPetClick,\n  customAvatarUrl,\n  onOpenImageStudio,\n  onOpenVoiceModal,\n}) => {\n  const [hearts, setHearts] = useState<{ id: number; x: number; y: number }[]>([]);\n  const [isHovered, setIsHovered] = useState(false);\n  const [avatarMode, setAvatarMode] = useState<\'animated\' | \'custom\'>(\n    customAvatarUrl ? \'custom\' : \'animated\'\n  );\n\n  const handleStageClick = (e: React.MouseEvent<HTMLDivElement>) => {\n    const rect = e.currentTarget.getBoundingClientRect();\n    const x = e.clientX - rect.left;\n    const y = e.clientY - rect.top;\n    const newHeart = { id: Date.now(), x, y };\n    setHearts((prev) => [...prev, newHeart]);\n    setTimeout(() => {\n      setHearts((prev) => prev.filter((h) => h.id !== newHeart.id));\n    }, 1200);\n\n    if (onPetClick) {\n      onPetClick();\n    }\n  };\n\n  // Determine aura and theme colors based on health\n  const getHealthTheme = (level: HealthLevel) => {\n    switch (level) {\n      case \'Healthy\':\n        return {\n          glow: \'rgba(16, 185, 129, 0.25)\',\n          pulseColor: \'border-emerald-400 bg-emerald-500/10 text-emerald-700\',\n          barBg: \'bg-emerald-500\',\n          badgeBg: \'bg-emerald-50 text-emerald-700 border-emerald-200\',\n          icon: CheckCircle2,\n          moodLabel: \'Relaxed & Playful\',\n          auraShadow: \'0 0 45px rgba(16, 185, 129, 0.3)\',\n        };\n      case \'Attention\':\n        return {\n          glow: \'rgba(245, 158, 11, 0.25)\',\n          pulseColor: \'border-amber-400 bg-amber-500/10 text-amber-700\',\n          barBg: \'bg-amber-500\',\n          badgeBg: \'bg-amber-50 text-amber-800 border-amber-200\',\n          icon: AlertTriangle,\n          moodLabel: \'Uneasy & Alert\',\n          auraShadow: \'0 0 45px rgba(245, 158, 11, 0.35)\',\n        };\n      case \'Blocked\':\n        return {\n          glow: \'rgba(239, 68, 68, 0.25)\',\n          pulseColor: \'border-rose-400 bg-rose-500/10 text-rose-700\',\n          barBg: \'bg-rose-500\',\n          badgeBg: \'bg-rose-50 text-rose-800 border-rose-200\',\n          icon: ShieldAlert,\n          moodLabel: \'Distressed & Blocked\',\n          auraShadow: \'0 0 45px rgba(239, 68, 68, 0.4)\',\n        };\n      case \'Unsafe\':\n      default:\n        return {\n          glow: \'rgba(100, 116, 139, 0.25)\',\n          pulseColor: \'border-slate-400 bg-slate-500/10 text-slate-700\',\n          barBg: \'bg-slate-500\',\n          badgeBg: \'bg-slate-100 text-slate-700 border-slate-300\',\n          icon: ShieldAlert,\n          moodLabel: \'Still & Protected\',\n          auraShadow: \'0 0 35px rgba(100, 116, 139, 0.25)\',\n        };\n    }\n  };\n\n  const theme = getHealthTheme(state.healthLevel);\n  const StatusIcon = theme.icon;\n\n  return (\n    <div\n      id=\"gitpet-stage-container\"\n      onClick={handleStageClick}\n      onMouseEnter={() => setIsHovered(true)}\n      onMouseLeave={() => setIsHovered(false)}\n      className=\"relative w-full rounded-2xl bg-white border border-slate-200/80 p-6 shadow-sm overflow-hidden select-none cursor-pointer transition-all duration-300 hover:shadow-md\"\n    >\n      {/* Background ambient radial glow */}\n      <motion.div\n        className=\"absolute inset-0 pointer-events-none transition-all duration-700\"\n        animate={{\n          background: `radial-gradient(circle at 50% 45%, ${theme.glow} 0%, rgba(255,255,255,0) 65%)`,\n        }}\n      />\n\n      {/* Floating click hearts */}\n      <AnimatePresence>\n        {hearts.map((h) => (\n          <motion.div\n            key={h.id}\n            initial={{ opacity: 1, scale: 0.5, y: h.y, x: h.x }}\n            animate={{ opacity: 0, scale: 1.4, y: h.y - 65, x: h.x + (Math.random() * 20 - 10) }}\n            exit={{ opacity: 0 }}\n            transition={{ duration: 1, ease: \'easeOut\' }}\n            className=\"absolute pointer-events-none z-30 text-rose-500 flex items-center gap-1 font-medium text-xs bg-white/90 px-2 py-0.5 rounded-full shadow-sm\"\n          >\n            <Heart className=\"w-3.5 h-3.5 fill-rose-500\" />\n            <span>*purrs safely*</span>\n          </motion.div>\n        ))}\n      </AnimatePresence>\n\n      {/* Top stage details: Mood badge & Health meter */}\n      <div className=\"relative z-10 flex flex-wrap items-center justify-between gap-3 mb-4\">\n        <div className=\"flex items-center gap-2.5\">\n          <div\n            className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold border ${theme.badgeBg}`}\n          >\n            <StatusIcon className=\"w-3.5 h-3.5\" />\n            <span>{state.healthLevel.toUpperCase()}</span>\n            <span className=\"opacity-40\">\342\200\242</span>\n            <span className=\"font-normal text-slate-600\">{theme.moodLabel}</span>\n          </div>\n\n          <span className=\"text-xs text-slate-500 hidden sm:inline-block\">\n            {state.primarySymptom === \'behind_remote\' && \'\360\237\220\225 Leash tension toward remote\'}\n            {state.primarySymptom === \'unpushed_work\' && \'\360\237\216\222 Heavy local backpack\'}\n            {state.primarySymptom === \'merge_conflict\' && \'\360\237\247\266 Tangled conflict yarn\'}\n            {state.primarySymptom === \'detached_head\' && \'\360\237\247\255 Lost wandering compass\'}\n            {state.primarySymptom === \'stale_branch\' && \'\360\237\222\244 Merged & snoozing\'}\n            {state.primarySymptom === \'clean_sync\' && \'\342\234\250 Sparkling in-sync\'}\n          </span>\n        </div>\n\n        {/* Health Progress Bar */}\n        <div className=\"flex items-center gap-2.5 min-w-[170px]\">\n          <span className=\"text-xs font-medium text-slate-500\">Repo Health</span>\n          <div className=\"flex-1 h-2.5 bg-slate-100 rounded-full overflow-hidden border border-slate-200/60 p-0.5\">\n            <motion.div\n              className={`h-full rounded-full ${theme.barBg}`}\n              initial={{ width: 0 }}\n              animate={{ width: `${state.healthPercentage}%` }}\n              transition={{ duration: 0.6, ease: \'easeOut\' }}\n            />\n          </div>\n          <span className=\"text-xs font-bold text-slate-700 w-8 text-right\">\n            {state.healthPercentage}%\n          </span>\n        </div>\n      </div>\n\n      {/* Center Stage: The Expressive Pet Canvas */}\n      <div className=\"relative z-10 flex flex-col items-center justify-center py-4 sm:py-6\">\n        <div className=\"relative flex items-center justify-center w-64 h-52\">\n          {/* Ambient pulse circle around pet */}\n          <motion.div\n            animate={{\n              scale: [1, 1.05, 1],\n              opacity: [0.6, 0.9, 0.6],\n            }}\n            transition={{\n              duration: 3,\n              repeat: Infinity,\n              ease: \'easeInOut\',\n            }}\n            style={{\n              boxShadow: theme.auraShadow,\n            }}\n            className=\"absolute w-44 h-44 rounded-full pointer-events-none\"\n          />\n\n          {/* Render Either Custom AI Generated Avatar or Interactive Vector Pet */}\n          {customAvatarUrl && avatarMode === \'custom\' ? (\n            <motion.div\n              className=\"relative flex items-center justify-center\"\n              animate={{ y: isHovered ? -8 : [0, -6, 0] }}\n              transition={{ duration: 2, repeat: Infinity, repeatType: \'reverse\', ease: \'easeInOut\' }}\n            >\n              <div className=\"relative w-44 h-44 rounded-3xl overflow-hidden border-4 border-white shadow-xl ring-4 ring-blue-500/20 bg-slate-900\">\n                <img\n                  src={customAvatarUrl}\n                  alt=\"Custom Mascot Avatar\"\n                  referrerPolicy=\"no-referrer\"\n                  className=\"w-full h-full object-cover\"\n                />\n                <div className=\"absolute bottom-1.5 right-1.5 px-2 py-0.5 bg-slate-900/80 backdrop-blur-xs text-[9px] font-mono font-bold text-amber-300 rounded-full border border-amber-500/30 flex items-center gap-1\">\n                  <Sparkles className=\"w-2.5 h-2.5\" /> AI Skin\n                </div>\n              </div>\n            </motion.div>\n          ) : (\n            <PetGraphic\n              symptom={state.primarySymptom}\n              healthLevel={state.healthLevel}\n              isHovered={isHovered}\n            />\n          )}\n        </div>\n\n        {/* Symptom diagnosis caption */}\n        <div className=\"mt-3 text-center max-w-md\">\n          <h3 className=\"text-sm font-semibold text-slate-900 flex items-center justify-center gap-1.5\">\n            <span>{state.symptomTitle}</span>\n          </h3>\n          <p className=\"text-xs text-slate-600 mt-1 leading-relaxed\">\n            {state.operatorMeaning}\n          </p>\n        </div>\n\n        {/* Quick Stage Controls for Image Studio & Voice */}\n        <div className=\"mt-4 flex flex-wrap items-center justify-center gap-2\">\n          {customAvatarUrl && (\n            <button\n              onClick={(e) => {\n                e.stopPropagation();\n                setAvatarMode(avatarMode === \'custom\' ? \'animated\' : \'custom\');\n              }}\n              className=\"px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg border border-slate-200 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <Layers className=\"w-3.5 h-3.5 text-blue-600\" />\n              <span>{avatarMode === \'custom\' ? \'View Vector Byte\' : \'View AI Avatar\'}</span>\n            </button>\n          )}\n\n          {onOpenImageStudio && (\n            <button\n              id=\"stage-open-image-studio-btn\"\n              onClick={(e) => {\n                e.stopPropagation();\n                onOpenImageStudio();\n              }}\n              className=\"px-2.5 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold rounded-lg border border-rose-200 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <Wand2 className=\"w-3.5 h-3.5 text-rose-600\" />\n              <span>Mascot Image Studio</span>\n            </button>\n          )}\n\n          {onOpenVoiceModal && (\n            <button\n              id=\"stage-open-voice-modal-btn\"\n              onClick={(e) => {\n                e.stopPropagation();\n                onOpenVoiceModal();\n              }}\n              className=\"px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold rounded-lg border border-indigo-200 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <Mic className=\"w-3.5 h-3.5 text-indigo-600\" />\n              <span>Talk with Byte</span>\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Floating hint at bottom */}\n      <div className=\"relative z-10 flex items-center justify-between text-[11px] text-slate-400 border-t border-slate-100 pt-3 mt-1\">\n        <span className=\"flex items-center gap-1\">\n          <Info className=\"w-3 h-3 text-slate-400\" />\n          <span>Click Byte to pet & check ambient responsiveness</span>\n        </span>\n        <span className=\"font-mono text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded\">\n          branch: {state.currentBranch.name}\n        </span>\n      </div>\n    </div>\n  );\n};\n\n// Sub-component: Expressive SVG Animated Pet Graphic\ninterface PetGraphicProps {\n  symptom: SymptomType;\n  healthLevel: HealthLevel;\n  isHovered: boolean;\n}\n\nconst PetGraphic: React.FC<PetGraphicProps> = ({ symptom, healthLevel, isHovered }) => {\n  const bounceTransition = {\n    duration: symptom === \'merge_conflict\' ? 0.8 : symptom === \'stale_branch\' ? 3.5 : 1.8,\n    repeat: Infinity,\n    repeatType: \'reverse\' as const,\n    ease: \'easeInOut\',\n  };\n\n  return (\n    <motion.div\n      className=\"relative flex items-center justify-center\"\n      animate={{\n        y: isHovered ? -8 : [0, -6, 0],\n      }}\n      transition={bounceTransition}\n    >\n      <svg\n        viewBox=\"0 0 200 180\"\n        className=\"w-48 h-44 drop-shadow-sm overflow-visible\"\n      >\n        <defs>\n          <linearGradient id=\"bodyGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#3B82F6\" />\n            <stop offset=\"100%\" stopColor=\"#1D4ED8\" />\n          </linearGradient>\n          <linearGradient id=\"bellyGradient\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#EFF6FF\" />\n            <stop offset=\"100%\" stopColor=\"#DBEAFE\" />\n          </linearGradient>\n          <linearGradient id=\"earGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#60A5FA\" />\n            <stop offset=\"100%\" stopColor=\"#2563EB\" />\n          </linearGradient>\n          <linearGradient id=\"backpackGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"#F59E0B\" />\n            <stop offset=\"100%\" stopColor=\"#D97706\" />\n          </linearGradient>\n        </defs>\n\n        {/* Tail */}\n        <motion.path\n          d=\"M 60 120 C 40 115, 30 90, 45 80 C 52 75, 60 85, 55 98\"\n          fill=\"none\"\n          stroke=\"#2563EB\"\n          strokeWidth=\"8\"\n          strokeLinecap=\"round\"\n          animate={{\n            rotate: symptom === \'clean_sync\' ? [-15, 25, -15] : symptom === \'stale_branch\' ? [0, 0] : [-5, 10, -5],\n            originX: \'60px\',\n            originY: \'120px\',\n          }}\n          transition={{\n            duration: symptom === \'clean_sync\' ? 0.4 : 1.2,\n            repeat: Infinity,\n            ease: \'easeInOut\',\n          }}\n        />\n\n        {/* Pet Body */}\n        <ellipse cx=\"100\" cy=\"115\" rx=\"42\" ry=\"34\" fill=\"url(#bodyGradient)\" />\n        {/* Pet Belly */}\n        <ellipse cx=\"100\" cy=\"118\" rx=\"26\" ry=\"20\" fill=\"url(#bellyGradient)\" />\n\n        {/* Pet Head */}\n        <ellipse cx=\"100\" cy=\"72\" rx=\"34\" ry=\"30\" fill=\"url(#bodyGradient)\" />\n\n        {/* Left Ear */}\n        <motion.path\n          d=\"M 72 56 C 60 25, 75 15, 82 45 Z\"\n          fill=\"url(#earGradient)\"\n          animate={{\n            rotate: symptom === \'behind_remote\' ? [-12, -8] : symptom === \'merge_conflict\' ? [-18, 5, -18] : [-4, 4, -4],\n            originX: \'78px\',\n            originY: \'50px\',\n          }}\n          transition={{ duration: 1.4, repeat: Infinity }}\n        />\n        {/* Right Ear */}\n        <motion.path\n          d=\"M 128 56 C 140 25, 125 15, 118 45 Z\"\n          fill=\"url(#earGradient)\"\n          animate={{\n            rotate: symptom === \'behind_remote\' ? [8, 12] : symptom === \'merge_conflict\' ? [5, -18, 5] : [4, -4, 4],\n            originX: \'122px\',\n            originY: \'50px\',\n          }}\n          transition={{ duration: 1.4, repeat: Infinity }}\n        />\n\n        {/* Paws */}\n        <ellipse cx=\"78\" cy=\"142\" rx=\"10\" ry=\"7\" fill=\"#1D4ED8\" />\n        <ellipse cx=\"122\" cy=\"142\" rx=\"10\" ry=\"7\" fill=\"#1D4ED8\" />\n\n        {/* Face Elements depending on symptom */}\n        {symptom === \'clean_sync\' && (\n          <g>\n            {/* Happy curved eyes */}\n            <path d=\"M 86 68 Q 92 62 98 68\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"3\" strokeLinecap=\"round\" />\n            <path d=\"M 102 68 Q 108 62 114 68\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"3\" strokeLinecap=\"round\" />\n            {/* Cute nose */}\n            <circle cx=\"100\" cy=\"74\" r=\"3.5\" fill=\"#1E293B\" />\n            {/* Smiling mouth */}\n            <path d=\"M 94 78 Q 100 84 106 78\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n            {/* Cheeks */}\n            <circle cx=\"84\" cy=\"74\" r=\"4.5\" fill=\"#F472B6\" opacity=\"0.6\" />\n            <circle cx=\"116\" cy=\"74\" r=\"4.5\" fill=\"#F472B6\" opacity=\"0.6\" />\n            {/* Sparkles around */}\n            <circle cx=\"145\" cy=\"45\" r=\"3\" fill=\"#10B981\" />\n            <circle cx=\"55\" cy=\"65\" r=\"2.5\" fill=\"#10B981\" />\n            <path d=\"M 148 40 L 152 40 M 150 38 L 150 42\" stroke=\"#10B981\" strokeWidth=\"2\" strokeLinecap=\"round\" />\n          </g>\n        )}\n\n        {symptom === \'behind_remote\' && (\n          <g>\n            {/* Alert determined eyes */}\n            <circle cx=\"90\" cy=\"68\" r=\"5\" fill=\"#FFFFFF\" />\n            <circle cx=\"91\" cy=\"68\" r=\"3\" fill=\"#0F172A\" />\n            <circle cx=\"110\" cy=\"68\" r=\"5\" fill=\"#FFFFFF\" />\n            <circle cx=\"111\" cy=\"68\" r=\"3\" fill=\"#0F172A\" />\n            {/* Nose */}\n            <circle cx=\"100\" cy=\"74\" r=\"3\" fill=\"#1E293B\" />\n            {/* Small open mouth */}\n            <ellipse cx=\"100\" cy=\"79\" rx=\"3.5\" ry=\"2.5\" fill=\"#FFFFFF\" />\n            {/* Leash pulling forward to the right! */}\n            <motion.path\n              d=\"M 100 95 C 130 98, 160 110, 190 100\"\n              fill=\"none\"\n              stroke=\"#F59E0B\"\n              strokeWidth=\"4\"\n              strokeDasharray=\"4 3\"\n              animate={{\n                strokeDashoffset: [0, -14],\n              }}\n              transition={{ duration: 1, repeat: Infinity, ease: \'linear\' }}\n            />\n            {/* Leash collar */}\n            <rect x=\"86\" y=\"90\" width=\"28\" height=\"6\" rx=\"3\" fill=\"#F59E0B\" />\n            {/* Pull motion arrows */}\n            <path d=\"M 175 92 L 188 98 L 175 104\" fill=\"none\" stroke=\"#F59E0B\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n          </g>\n        )}\n\n        {symptom === \'unpushed_work\' && (\n          <g>\n            {/* Looking up / wide eyes */}\n            <circle cx=\"90\" cy=\"67\" r=\"5.5\" fill=\"#FFFFFF\" />\n            <circle cx=\"90\" cy=\"65\" r=\"3\" fill=\"#0F172A\" />\n            <circle cx=\"110\" cy=\"67\" r=\"5.5\" fill=\"#FFFFFF\" />\n            <circle cx=\"110\" cy=\"65\" r=\"3\" fill=\"#0F172A\" />\n            <circle cx=\"100\" cy=\"74\" r=\"3\" fill=\"#1E293B\" />\n            <path d=\"M 96 79 Q 100 81 104 79\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n            {/* Heavy Backpack on Pet\'s back */}\n            <g transform=\"translate(48, 88)\">\n              <rect x=\"0\" y=\"0\" width=\"26\" height=\"32\" rx=\"6\" fill=\"url(#backpackGrad)\" stroke=\"#B45309\" strokeWidth=\"1.5\" />\n              <rect x=\"4\" y=\"6\" width=\"18\" height=\"10\" rx=\"3\" fill=\"#FEF3C7\" />\n              {/* Commit stack icon in backpack */}\n              <circle cx=\"13\" cy=\"11\" r=\"2.5\" fill=\"#D97706\" />\n              <line x1=\"13\" y1=\"13\" x2=\"13\" y2=\"24\" stroke=\"#D97706\" strokeWidth=\"2\" />\n              <circle cx=\"13\" cy=\"24\" r=\"2.5\" fill=\"#D97706\" />\n              {/* Straps */}\n              <path d=\"M 22 4 C 32 8, 32 24, 22 28\" fill=\"none\" stroke=\"#92400E\" strokeWidth=\"2.5\" />\n            </g>\n          </g>\n        )}\n\n        {symptom === \'merge_conflict\' && (\n          <g>\n            {/* Distressed spiral/swirl eyes */}\n            <g transform=\"translate(86, 64)\">\n              <circle cx=\"4\" cy=\"4\" r=\"6\" fill=\"#FFFFFF\" />\n              <path d=\"M 1 4 Q 4 1 7 4 Q 4 7 1 4\" fill=\"none\" stroke=\"#EF4444\" strokeWidth=\"2\" />\n            </g>\n            <g transform=\"translate(106, 64)\">\n              <circle cx=\"4\" cy=\"4\" r=\"6\" fill=\"#FFFFFF\" />\n              <path d=\"M 1 4 Q 4 1 7 4 Q 4 7 1 4\" fill=\"none\" stroke=\"#EF4444\" strokeWidth=\"2\" />\n            </g>\n            <circle cx=\"100\" cy=\"74\" r=\"3\" fill=\"#1E293B\" />\n            {/* Wobbly wavy mouth */}\n            <path d=\"M 94 80 Q 97 77 100 80 Q 103 83 106 80\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n            {/* Tangled Yarn all over */}\n            <motion.path\n              d=\"M 70 100 C 60 70, 130 60, 120 110 C 110 150, 75 125, 95 95 C 115 65, 140 120, 80 130\"\n              fill=\"none\"\n              stroke=\"#EF4444\"\n              strokeWidth=\"3.5\"\n              strokeLinecap=\"round\"\n              animate={{\n                strokeDasharray: [\'8 4\', \'4 8\', \'8 4\'],\n              }}\n              transition={{ duration: 2, repeat: Infinity }}\n            />\n            <path\n              d=\"M 65 115 C 80 140, 135 130, 130 90 C 125 50, 75 60, 85 85\"\n              fill=\"none\"\n              stroke=\"#38BDF8\"\n              strokeWidth=\"2.5\"\n              strokeLinecap=\"round\"\n            />\n            {/* Conflict markers icon */}\n            <text x=\"145\" y=\"65\" fontSize=\"16\" fontWeight=\"bold\" fill=\"#EF4444\">\n              &lt;&lt;&lt;\n            </text>\n            <text x=\"40\" y=\"85\" fontSize=\"16\" fontWeight=\"bold\" fill=\"#EF4444\">\n              &gt;&gt;&gt;\n            </text>\n          </g>\n        )}\n\n        {symptom === \'detached_head\' && (\n          <g>\n            {/* Wide wandering confused eyes */}\n            <circle cx=\"89\" cy=\"67\" r=\"6\" fill=\"#FFFFFF\" />\n            <circle cx=\"88\" cy=\"67\" r=\"3\" fill=\"#64748B\" />\n            <circle cx=\"111\" cy=\"67\" r=\"6\" fill=\"#FFFFFF\" />\n            <circle cx=\"112\" cy=\"67\" r=\"3\" fill=\"#64748B\" />\n            <circle cx=\"100\" cy=\"74\" r=\"3\" fill=\"#1E293B\" />\n            <ellipse cx=\"100\" cy=\"79\" rx=\"3\" ry=\"2\" fill=\"#FFFFFF\" />\n            {/* Floating detached dashed circle above head */}\n            <motion.ellipse\n              cx=\"100\"\n              cy=\"34\"\n              rx=\"18\"\n              ry=\"8\"\n              fill=\"none\"\n              stroke=\"#94A3B8\"\n              strokeWidth=\"2\"\n              strokeDasharray=\"4 3\"\n              animate={{ rotate: [0, 360], originX: \'100px\', originY: \'34px\' }}\n              transition={{ duration: 6, repeat: Infinity, ease: \'linear\' }}\n            />\n            {/* Spinning compass needle */}\n            <g transform=\"translate(145, 50)\">\n              <circle cx=\"12\" cy=\"12\" r=\"12\" fill=\"#FFFFFF\" stroke=\"#64748B\" strokeWidth=\"1.5\" />\n              <motion.path\n                d=\"M 12 4 L 15 12 L 9 12 Z\"\n                fill=\"#EF4444\"\n                animate={{ rotate: [0, 180, 45, 270, 0], originX: \'12px\', originY: \'12px\' }}\n                transition={{ duration: 4, repeat: Infinity, ease: \'easeInOut\' }}\n              />\n              <motion.path\n                d=\"M 12 20 L 15 12 L 9 12 Z\"\n                fill=\"#64748B\"\n                animate={{ rotate: [0, 180, 45, 270, 0], originX: \'12px\', originY: \'12px\' }}\n                transition={{ duration: 4, repeat: Infinity, ease: \'easeInOut\' }}\n              />\n            </g>\n          </g>\n        )}\n\n        {symptom === \'stale_branch\' && (\n          <g>\n            {/* Sleeping closed eyes */}\n            <path d=\"M 85 68 Q 90 73 95 68\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n            <path d=\"M 105 68 Q 110 73 115 68\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n            <circle cx=\"100\" cy=\"74\" r=\"3\" fill=\"#1E293B\" />\n            {/* Little nightcap */}\n            <path d=\"M 80 48 C 75 25, 110 20, 120 48 Z\" fill=\"#6366F1\" />\n            <circle cx=\"73\" cy=\"24\" r=\"5\" fill=\"#FEF08A\" />\n            {/* Snoozing Zzz particles */}\n            <motion.text\n              x=\"135\"\n              y=\"50\"\n              fontSize=\"12\"\n              fontWeight=\"bold\"\n              fill=\"#818CF8\"\n              animate={{ opacity: [0, 1, 0], y: [50, 35] }}\n              transition={{ duration: 2, repeat: Infinity, ease: \'easeOut\' }}\n            >\n              Z\n            </motion.text>\n            <motion.text\n              x=\"145\"\n              y=\"38\"\n              fontSize=\"16\"\n              fontWeight=\"bold\"\n              fill=\"#6366F1\"\n              animate={{ opacity: [0, 1, 0], y: [38, 20] }}\n              transition={{ duration: 2, delay: 0.7, repeat: Infinity, ease: \'easeOut\' }}\n            >\n              Z\n            </motion.text>\n            {/* Cobweb detail on edge */}\n            <path d=\"M 50 120 L 65 130 M 50 125 L 60 135\" stroke=\"#CBD5E1\" strokeWidth=\"1.5\" />\n          </g>\n        )}\n      </svg>\n    </motion.div>\n  );\n};\n"
    }
